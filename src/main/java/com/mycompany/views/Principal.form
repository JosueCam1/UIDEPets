      <SubComponents>
        <Component class="javax.swing.JLabel" name="jLabel13">
          <Properties>
            <Property name="horizontalAlignment" type="int" value="11"/>
            <Property name="icon" type="javax.swing.Icon" editor="org.netbeans.modules.form.editors2.IconEditor">
              <Image iconType="3" name="/Principal.png"/>
            </Property>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Bienvenida">
          <Properties>
            <Property name="text" type="java.lang.String" value="Bienvenido a UIDE Pets"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea1">
          <Properties>
            <Property name="text" type="java.lang.String" value="\ud83d\udc3e Donde el amor por las mascotas se encuentra con la comodidad de comprar en l&#xed;nea! \ud83d\udc3e" containsInvalidXMLChars="true"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea2">
          <Properties>
            <Property name="text" type="java.lang.String" value="&quot;Todo para ellos, todo para ti. UIDEpets, tu mejor aliado en cuidado de mascotas.&quot;"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea3">
          <Properties>
            <Property name="text" type="java.lang.String" value="En UIDEpets sabemos que tus peludos amigos son parte de tu familia, y por eso nos dedicamos"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea4">
          <Properties>
            <Property name="text" type="java.lang.String" value="a ofrecerte los mejores productos, desde alimentos premium hasta juguetes, "/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea5">
          <Properties>
            <Property name="text" type="java.lang.String" value="accesorios y todo lo que necesitas para su bienestar."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Pregunta">
          <Properties>
            <Property name="text" type="java.lang.String" value="&#xbf;Por qu&#xe9; elegirnos?"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea6">
          <Properties>
            <Property name="text" type="java.lang.String" value=" Productos de calidad: Seleccionamos las marcas m&#xe1;s confiables y saludables."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea7">
          <Properties>
            <Property name="text" type="java.lang.String" value="Env&#xed;os r&#xe1;pidos y seguros: Recibe tus pedidos en la puerta de tu hogar sin complicaciones."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea8">
          <Properties>
            <Property name="text" type="java.lang.String" value="Asesoramiento experto: Nuestro equipo te ayuda a tomar las mejores decisiones para tu mascota."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea9">
          <Properties>
            <Property name="text" type="java.lang.String" value="&#xa1;Haz tus compras en UIDEpets y dale a tu mascota el cuidado que se merece, con la facilidad de un clic! \ud83d\uded2\ud83d\udc36\ud83d\udc31\ud83d\udc30" containsInvalidXMLChars="true"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="Linea10">
          <Properties>
            <Property name="text" type="java.lang.String" value="Porque en UIDEpets&#x2026; &#xa1;tu felicidad es su felicidad! \ud83d\udc15&#x2764;&#xfe0f;" containsInvalidXMLChars="true"/>
          </Properties>
        </Component>
